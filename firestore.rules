rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function validMessage(message) {
      return message is string && message.size() > 0 && message.size() <= 250;
    }

    function currentFriend(otherUid) {
      return exists(/databases/$(database)/documents/friendships/$(me() + '_' + otherUid))
        || exists(/databases/$(database)/documents/friendships/$(otherUid + '_' + me()));
    }

    // Private financial profile: owner only (unchanged).
    match /profiles/{userId} {
      // The anonymous benchmark pseudonym may be chosen once, then remains
      // locked in the private profile. This prevents a later profile edit
      // from taking over somebody else's contribution document.
      function validBenchmarkContributorId(value) {
        return value is string
          && value.matches('^[0-9a-f]{32}$');
      }
      function validBenchmarkContributorState(profile) {
        return !profile.keys().hasAll(['benchmarkContributorId'])
          || profile.benchmarkContributorId == ''
          || validBenchmarkContributorId(profile.benchmarkContributorId);
      }
      function keepsBenchmarkContributorId() {
        // Older profiles have no id. They may remain blank or choose one
        // valid id once. A valid id can never be replaced afterwards.
        return !resource.data.keys().hasAll(['benchmarkContributorId'])
          ? (!request.resource.data.keys().hasAll(['benchmarkContributorId'])
            || request.resource.data.benchmarkContributorId == ''
            || validBenchmarkContributorId(request.resource.data.benchmarkContributorId))
          : validBenchmarkContributorId(resource.data.benchmarkContributorId)
            ? request.resource.data.benchmarkContributorId == resource.data.benchmarkContributorId
            : (request.resource.data.benchmarkContributorId == ''
              || validBenchmarkContributorId(request.resource.data.benchmarkContributorId));
      }
      allow read: if signedIn() && me() == userId;
      allow create: if signedIn() && me() == userId
        && validBenchmarkContributorState(request.resource.data);
      allow update: if signedIn() && me() == userId && keepsBenchmarkContributorId();
      allow delete: if signedIn() && me() == userId;
    }

    // ── Community ────────────────────────────────────────────────────────
    // Exact-match email directory. `get` only: no listing, so nobody can
    // enumerate users. You may only claim the entry for your own verified
    // auth email.
    match /userDirectory/{emailLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == emailLower
        && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Pending friend requests; id is `{fromUid}_{toUid}`.
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == me() || resource.data.toUid == me());
      allow create: if signedIn()
        && request.resource.data.fromUid == me()
        && request.resource.data.toUid != me()
        && requestId == me() + '_' + request.resource.data.toUid
        && request.resource.data.from.uid == me()
        && request.resource.data.to.uid == request.resource.data.toUid
        && request.resource.data.createdAt == request.time;
      // Sender cancels, recipient declines / accepts (accept deletes it).
      allow delete: if signedIn()
        && (resource.data.fromUid == me() || resource.data.toUid == me());
      allow update: if false;
    }

    // Accepted friendships; id is the two uids sorted and joined by `_`.
    // Only the recipient can create one, and only while the matching
    // request exists (accept is one batch: create friendship + delete
    // request, and `exists` sees the pre-batch state).
    match /friendships/{friendshipId} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.accepterUid == me()
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(
             [request.resource.data.requesterUid, me()])
        && (friendshipId == request.resource.data.requesterUid + '_' + me()
            || friendshipId == me() + '_' + request.resource.data.requesterUid)
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requesterUid + '_' + me()));
      // Either friend can unfriend.
      allow delete: if signedIn() && me() in resource.data.members;
      allow update: if false;
    }

    // Coarse, opt-in states for the named trusted-circle comparison. Exact
    // amounts and private-profile fields never leave `profiles/{uid}`.
    match /circleSnapshots/{userId} {
      function ownerSharingEnabled() {
        return get(/databases/$(database)/documents/profiles/$(userId)).data.consentTrustedCircle == true;
      }
      function validCircleSnapshot() {
        return request.resource.data.keys().hasOnly(
             ['emergencyBand', 'savingBand', 'planBand', 'cashflowBand', 'goalBand', 'pyramidBand', 'updatedAt'])
          && request.resource.data.emergencyBand in ['under_one', 'one_to_three', 'three_plus']
          && request.resource.data.savingBand in ['none', 'some', 'twenty_plus']
          && request.resource.data.planBand in ['starting', 'active', 'committed']
          // Permit the former three-signal payload during the client rollout,
          // or require all three new derived standing signals together.
          && (request.resource.data.keys().hasOnly(
                ['emergencyBand', 'savingBand', 'planBand', 'updatedAt'])
              || (request.resource.data.keys().hasAll(
                    ['cashflowBand', 'goalBand', 'pyramidBand'])
                  && request.resource.data.cashflowBand in ['tight', 'balanced', 'stable']
                  && request.resource.data.goalBand in ['starting', 'building', 'on_track']
                  && request.resource.data.pyramidBand in ['foundation', 'developing', 'advancing']))
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if signedIn() && (me() == userId
        || (currentFriend(userId) && ownerSharingEnabled()));
      allow create, update: if signedIn() && me() == userId
        && ownerSharingEnabled() && validCircleSnapshot();
      allow delete: if signedIn() && me() == userId;
    }

    // Community notifications (likes, replies, accepted requests). Only the
    // owner reads them; only a current friend can drop one in, as
    // themselves. Like notifications use a fixed id so the liker may
    // overwrite their own; the owner may only flip `read`.
    match /users/{userId}/notifications/{notificationId} {
      function isFriendOf(other) {
        return exists(/databases/$(database)/documents/friendships/$(me() + '_' + other))
          || exists(/databases/$(database)/documents/friendships/$(other + '_' + me()));
      }

      function validFromActor() {
        return userId != me()
          && request.resource.data.actorUid == me()
          && request.resource.data.actor.uid == me()
          && request.resource.data.type in ['reply', 'like', 'friend_accepted']
          && request.resource.data.read == false
          && request.resource.data.preview is string
          && request.resource.data.preview.size() <= 200
          && request.resource.data.createdAt == request.time
          && isFriendOf(userId);
      }

      allow read, delete: if signedIn() && me() == userId;
      allow create: if signedIn() && validFromActor();
      allow update: if signedIn() && (
        (me() == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (resource.data.actorUid == me() && validFromActor())
      );
    }

    // Posts are fanned out on write: `audience` holds every uid allowed
    // to read the post (author + friends at post time, or just the author
    // for "Only Me").
    match /posts/{postId} {
      allow read: if signedIn() && me() in resource.data.audience;

      allow create: if signedIn()
        && request.resource.data.authorUid == me()
        && request.resource.data.author.uid == me()
        && validMessage(request.resource.data.message)
        && request.resource.data.visibility in ['friends', 'only_me']
        && request.resource.data.kind in [
             'update', 'question', 'goal_progress', 'action_progress']
        && request.resource.data.audience is list
        && me() in request.resource.data.audience
        && request.resource.data.audience.size() <= 500
        && (request.resource.data.visibility == 'friends'
            || request.resource.data.audience.size() == 1)
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.decisionVotes is map
        && request.resource.data.decisionVotes.size() == 0
        && request.resource.data.createdAt == request.time;

      allow delete: if signedIn() && resource.data.authorUid == me();

      // Audience members may only add/remove *their own* like, or move the
      // reply count by exactly one (alongside adding/deleting a reply).
      allow update: if signedIn() && me() in resource.data.audience && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && request.resource.data.likedBy.toSet()
               .difference(resource.data.likedBy.toSet())
               .union(resource.data.likedBy.toSet()
                 .difference(request.resource.data.likedBy.toSet()))
               .hasOnly([me()]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
          && (request.resource.data.commentCount == resource.data.commentCount + 1
              || (request.resource.data.commentCount == resource.data.commentCount - 1
                  && request.resource.data.commentCount >= 0)))
      );

      match /comments/{commentId} {
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }
        allow read: if signedIn() && me() in parentPost().audience;
        allow create: if signedIn()
          && me() in parentPost().audience
          && parentPost().visibility == 'friends'
          && request.resource.data.authorUid == me()
          && request.resource.data.author.uid == me()
          && validMessage(request.resource.data.message)
          && request.resource.data.createdAt == request.time;
        // Authors can delete their own replies; nobody can edit them.
        allow delete: if signedIn() && resource.data.authorUid == me();
        allow update: if false;
      }
    }

    // The audience is fixed at creation; a recipient also needs a current
    // friendship with the author, so unfriending revokes access immediately.
    match /decisionRequests/{requestId} {
      function decisionMember() {
        return signedIn() && me() in resource.data.audience && (
          me() == resource.data.authorUid ||
            (exists(/databases/$(database)/documents/friendships/$(me() + '_' + resource.data.authorUid)) ||
            exists(/databases/$(database)/documents/friendships/$(resource.data.authorUid + '_' + me()))));
      }
      allow read: if decisionMember();
      allow create: if signedIn()
        && request.resource.data.authorUid == me()
        && request.resource.data.author.uid == me()
        && validMessage(request.resource.data.message)
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 4
        && request.resource.data.audience is list
        && me() in request.resource.data.audience
        && request.resource.data.audience.size() >= 2
        && request.resource.data.audience.size() <= 11
        && request.resource.data.status == 'open'
        && request.resource.data.closeAt > request.time
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.authorUid == me()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'closedAt'])
        && request.resource.data.status == 'closed'
        && request.resource.data.closedAt == request.time;
      allow delete: if signedIn() && resource.data.authorUid == me();

      match /responses/{responseId} {
        function responseViewer() {
          return signedIn()
            && me() in get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.audience
            && (me() == get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.authorUid
              || (exists(/databases/$(database)/documents/friendships/$(me() + '_' + get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.authorUid))
              || exists(/databases/$(database)/documents/friendships/$(get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.authorUid + '_' + me()))));
        }
        allow read: if responseViewer();
        function validResponse() {
          return request.resource.data.author.uid == me()
            && request.resource.data.option in get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.options
            && request.resource.data.comment is string
            && request.resource.data.comment.size() <= 250
            && request.resource.data.allowAiReview is bool
            && request.resource.data.updatedAt == request.time;
        }
        function eligibleResponder() {
          return signedIn()
            && me() != get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.authorUid
            && me() in get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.audience
            && get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.status == 'open'
            && request.time < get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.closeAt
            && (
              exists(/databases/$(database)/documents/friendships/$(me() + '_' + get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.authorUid))
              || exists(/databases/$(database)/documents/friendships/$(get(/databases/$(database)/documents/decisionRequests/$(requestId)).data.authorUid + '_' + me()))
            );
        }
        allow create: if eligibleResponder() && validResponse() && responseId == me();
        allow update: if eligibleResponder() && validResponse()
          && responseId == me()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['option', 'comment', 'allowAiReview', 'updatedAt']);
        allow delete: if signedIn() && responseId == me();
      }
    }

    // A participant contributes only coarse bands. The app calculates the
    // aggregate on-device from anonymous records, so individual records must
    // be queryable by other opted-in participants.
    match /benchmarkContributions/{contributionId} {
      function benchmarkOptedIn() {
        return signedIn()
          && get(/databases/$(database)/documents/profiles/$(me())).data.consentBenchmarking == true;
      }
      function myContribution() {
        return contributionId == get(/databases/$(database)/documents/profiles/$(me())).data.benchmarkContributorId
          + '_' + request.resource.data.month;
      }
      function validContribution() {
        return request.resource.data.keys().hasOnly(
             ['month', 'cohort', 'emergencyBand', 'savingBand', 'cashflowBand', 'goalBand', 'pyramidBand', 'updatedAt'])
          && request.resource.data.month is string
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.cohort is string
          && request.resource.data.cohort.size() > 0
          && request.resource.data.cohort.size() <= 40
          && request.resource.data.emergencyBand in ['under_one', 'one_to_three', 'three_plus']
          && request.resource.data.savingBand in ['none', 'some', 'twenty_plus']
          // Legacy two-signal contributions remain writable while older app
          // clients are live; new contributions carry the complete standing
          // signal set so the anonymous dashboard can show all distributions.
          && (request.resource.data.keys().hasOnly(
                ['month', 'cohort', 'emergencyBand', 'savingBand', 'updatedAt'])
              || (request.resource.data.keys().hasAll(
                    ['cashflowBand', 'goalBand', 'pyramidBand'])
                  && request.resource.data.cashflowBand in ['tight', 'balanced', 'stable']
                  && request.resource.data.goalBand in ['starting', 'building', 'on_track']
                  && request.resource.data.pyramidBand in ['foundation', 'developing', 'advancing']))
          && request.resource.data.updatedAt == request.time;
      }
      // Records contain only categorical standing bands and a random
      // pseudonymous document id. Opted-in users can query them so their own
      // device can calculate the aggregate; no income, amount, account, or
      // uid is stored.
      allow read: if benchmarkOptedIn();
      allow create, update: if benchmarkOptedIn() && myContribution() && validContribution();
      allow delete: if false;
    }
    match /benchmarkAggregates/{aggregateId} {
      allow write: if false;
      allow read: if false;
    }

    match /communityRateLimits/{userId} {
      allow read, write: if false;
    }
  }
}
